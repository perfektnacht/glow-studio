#!/bin/bash
# Toggle the Glow Studio board. Bind this to a key, or call it from a script.
#
#   omarchy-glow-studio          toggle
#   omarchy-glow-studio show     open
#   omarchy-glow-studio hide     close

set -euo pipefail

PLUGIN_ID="perfektnacht.glow-studio"

case "${1:-toggle}" in
  show) omarchy-shell shell summon "$PLUGIN_ID" '{}' ;;
  hide) omarchy-shell shell hide "$PLUGIN_ID" ;;
  toggle) omarchy-shell shell toggle "$PLUGIN_ID" '{}' ;;
  *)
    echo "usage: ${0##*/} [toggle|show|hide]" >&2
    exit 1
    ;;
esac
